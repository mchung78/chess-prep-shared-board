{
  "rules": {
    "board": {
      ".read": true,
      "state": {
        ".write": "newData.exists() && auth != null && root.child('admin/writesEnabled').val() === true && root.child('admin/authorizedWriters').child(auth.uid).val() === true",
        ".validate": "newData.hasChildren(['schemaVersion', 'baseFen', 'currentFen', 'movesSan', 'updatedAt'])",
        "schemaVersion": { ".validate": "newData.isNumber() && newData.val() === 1" },
        "baseFen": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 100" },
        "currentFen": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 100" },
        "movesSan": { ".validate": "newData.isString() && newData.val().length <= 10000" },
        "updatedAt": { ".validate": "newData.isNumber()" },
        "$other": { ".validate": false }
      },
      "$other": { ".validate": false }
    },
    "admin": { ".read": false, ".write": false },
    "$other": { ".read": false, ".write": false }
  }
}
