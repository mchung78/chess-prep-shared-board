{
  "rules": {
    "board": {
      ".read": true,
      ".write": "root.child('admin/writesEnabled').val() === true && auth != null && root.child('admin/authorizedWriters').child(auth.uid).val() === true",
      ".validate": "newData.hasChildren(['fen', 'moves', 'updatedAt'])",
      "fen": {
        ".validate": "newData.isString() && newData.val().length <= 100"
      },
      "moves": {
        "$index": {
          ".validate": "$index.matches(/^[0-9]{1,3}$/) && newData.isString() && newData.val().length <= 10"
        }
      },
      "updatedAt": {
        ".validate": "newData.isNumber()"
      },
      "$other": {
        ".validate": false
      }
    },
    "admin": {
      ".read": false,
      ".write": false
    },
    "$other": {
      ".read": false,
      ".write": false
    }
  }
}
